# ============================================================================
#  Hospital Core — environment variable template
#  Copy to .env and fill in. Never commit a real .env (it is in .gitignore).
#    cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------- BACKEND --
# Port the core API binds to.
PORT=5000

# development | production | test
NODE_ENV=development

# MongoDB connection string.
#   Local (bare metal) : mongodb://localhost:27017/hospital
#   Docker Compose     : mongodb://mongo:27017/hospital
#   Kubernetes         : mongodb://mongo-service:27017/hospital
#   Atlas (production) : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hospital?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/hospital

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Where the core API forwards appointment writes.
# Leave BLANK to run appointment booking inside the core process (monolith mode) —
# that is what the Vercel single-function deployment and CI both do.
APPOINTMENT_SERVICE_URL=http://localhost:5001
APPOINTMENT_SERVICE_TIMEOUT_MS=5000

# --------------------------------------------- APPOINTMENT MICROSERVICE ----
# These belong in services/appointment-service/.env
# PORT=5001
# MONGO_URI=mongodb://localhost:27017/hospital
# CORE_API_URL=http://localhost:5000/api
# SKIP_CORE_VALIDATION=false   # true only in isolated tests

# --------------------------------------------------------------- FRONTEND --
# These belong in frontend/.env — Vite only exposes VITE_-prefixed variables to
# the browser bundle, and they are baked in at BUILD time, not read at runtime.
#
#   Local dev (Vite proxies /api to VITE_PROXY_TARGET):
# VITE_API_URL=/api
# VITE_PROXY_TARGET=http://localhost:5000
#
#   Netlify production (points at the deployed Vercel API):
# VITE_API_URL=https://your-api.vercel.app/api

# ----------------------------------------------------------- PRODUCTION ----
# Set these in the hosting provider's dashboard, not in a committed file:
#   Vercel  -> MONGO_URI, CORS_ORIGINS, NODE_ENV=production
#   Netlify -> VITE_API_URL
