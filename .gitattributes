# Normalize line endings so a Windows checkout doesn't produce files that break
# on Linux. Without this, a .sh file checked out with CRLF fails inside a
# container with "bad interpreter: /bin/bash^M".

* text=auto

# Must be LF — these execute in Linux (WSL, Docker, Minikube, CI runners).
*.sh            text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
.dockerignore   text eol=lf
nginx.conf      text eol=lf

# Source and config: normalized to LF in the repo, checked out natively.
*.js            text
*.jsx           text
*.json          text
*.css           text
*.html          text
*.md            text
*.toml          text

# Binary — never touch these.
*.png           binary
*.jpg           binary
*.ico           binary
*.pdf           binary
