{
  "name": "hospital-core-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hospital Core SPA — React 18 + React Query",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "cross-env NODE_ENV=test jest",
    "test:ci": "cross-env NODE_ENV=test jest --ci --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "@tanstack/react-query-devtools": "^5.51.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.24.7",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.1",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "vite": "^5.4.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/src/__tests__/setupTests.js"],
    "moduleNameMapper": {
      "\\.(css|less|scss)$": "identity-obj-proxy"
    },
    "globals": {
      "__API_BASE__": "http://localhost:5000/api"
    },
    "testMatch": ["<rootDir>/src/**/__tests__/**/*.test.jsx", "<rootDir>/src/**/*.test.jsx"],
    "transform": {
      "^.+\\.(js|jsx)$": ["babel-jest", { "configFile": "./babel.config.cjs" }]
    },
    "collectCoverageFrom": ["src/**/*.{js,jsx}", "!src/main.jsx"]
  }
}
